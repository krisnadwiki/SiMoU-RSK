APP_NAME="SiMoU RSUD Kilisuci"
APP_SHORT="SiMoU"
APP_ENV=development
APP_URL=auto # Gunakan 'auto' agar host & port dideteksi dinamis dari IP/Domain VPS
APP_VERSION=1.0.0

# Database (matches simou-db service)
DB_HOST=simou-db
DB_PORT=3306
DB_DATABASE=simou_db
DB_USERNAME=simou_user
DB_PASSWORD=simou_password

# Session
SESSION_TIMEOUT=3600
TIMEZONE=Asia/Jakarta

# Login Rate Limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=600
LOGIN_LOCKOUT_SECONDS=900

# File Upload
UPLOAD_MAX_MB=10
